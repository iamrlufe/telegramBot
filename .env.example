# Пример .env для AgentMonitor. Скопируйте рядом с docker-compose.yml:
#   cp .env.example .env
# и заполните значения. Реальный .env в репозиторий не попадает.
#
# Закомментированные строки — необязательные параметры, показаны значения
# по умолчанию. Раскомментируйте только то, что действительно меняете.

# ─── PostgreSQL (база мониторинга) ───────────────────────────
POSTGRES_DB=agentmonitor
POSTGRES_USER=agentmonitor
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
# POSTGRES_POOL_SIZE=10            # размер пула соединений

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=токен_бота_из_BotFather
TELEGRAM_ALLOWED_USER_ID=твой_telegram_id
# TELEGRAM_GROUP_ID=               # ID группы: туда уходят алерты вместо лички.
                                   # У супергрупп отрицательный, вида -100123…
# TELEGRAM_DELETE_USERS=           # ID через запятую: кому разрешены опасные
                                   # действия — удаление бэкапов, правка конфига,
                                   # перезапуск служб и перезагрузка сервера

# ─── WinRM (Windows-серверы) ─────────────────────────────────
# Общие учётные данные; у сервера в servers.json можно задать свои.
WINRM_USERNAME=monitoring
WINRM_PASSWORD=change_me
# WINRM_MESSAGE_ENCRYPTION=auto    # auto | always — always запрещает передачу
                                   # без шифрования полезной нагрузки

# ─── SSH (Linux-серверы и NAS) ───────────────────────────────
# SSH_USERNAME=monitoring
# SSH_PASSWORD=change_me
# SSH_KEY_PATH=/app/config/ssh_key # путь к ключу ВНУТРИ контейнера, вместо пароля

# ─── VMware (vCenter / ESXi) ─────────────────────────────────
# VMWARE_USERNAME=monitor@vsphere.local
# VMWARE_PASSWORD=change_me
# VMWARE_VERIFY_SSL=true           # false — не проверять сертификат vCenter
# VMWARE_LEGACY_TLS=false          # true нужен только для vSphere 6.0/6.5

# ─── Цикл мониторинга ────────────────────────────────────────
# CHECK_INTERVAL_SECONDS=300       # полный опрос серверов
# PING_INTERVAL_SECONDS=30         # ping, когда всё в порядке
# PING_DOWN_INTERVAL_SECONDS=10    # ping, пока кто-то не отвечает: быстрее
                                   # видно и падение, и возврат в строй
# PING_FAIL_SECONDS=120            # сколько секунд молчания = сервер упал
# RETAIN_DAYS=30                   # история метрик в базе
# SNAPSHOT_RETAIN_DAYS=3           # службы и топ процессов: читается только
                                   # последняя запись, история не нужна
# MONITOR_STALL_EXIT_MINUTES=30    # пульс застыл на N минут — процесс выходит,
                                   # docker поднимает его заново. 0 — выключить
# PROBLEMS_CACHE_SECONDS=45        # сколько живёт готовая сводка 🚨 Проблемы
                                   # (0 — пересчитывать на каждое нажатие)

# ─── Журналы Windows и SQL (сводка для дашборда) ─────────────
# Раздел логов в карточке сервера читает журналы живьём и этих настроек
# не касается — они только про фоновый сбор сводки для дашборда.
# LOG_SCAN_MINUTES=60              # как часто читать журналы. Сводка видна
                                   # дважды в сутки, чаще незачем.
                                   # 0 — каждый цикл монитора (5 мин)
# LOG_WINDOW_HOURS=24              # за какой период собирать события
# MAX_PARALLEL_LOG_SERVERS=4       # сколько серверов опрашивать одновременно

# ─── IIS (сводка для дашборда) ───────────────────────────────
# Сервер считается IIS-сервером, если среди services есть W3SVC.
# Логи сайта читаются по смещению: суточный файл на живой публикации 1С —
# это десятки мегабайт, целиком он перечитывается только при первом сборе.
# IIS_SCAN_MINUTES=60              # как часто дочитывать логи (0 — каждый цикл)
# IIS_SLOW_MS=10000                # запрос дольше N мс считается медленным
# MAX_PARALLEL_IIS_SERVERS=2       # сколько IIS-серверов читать одновременно

# ─── Бэкапы ──────────────────────────────────────────────────
# BACKUP_SCAN_MINUTES=30           # как часто обходить каталоги бэкапов.
                                   # Копия появляется раз в сутки, а обход —
                                   # это удалённая сессия и десятки тысяч
                                   # файлов в выдаче. 0 — каждый цикл (5 мин)
# BACKUP_ALERT_HOURS=25            # алерт «БЭКАП УСТАРЕЛ», если у сервера
                                   # или пути не задано своё значение
# BACKUP_SIZE_CHECK_MIN_RATIO=0.97 # порог «подозрительно маленький»
# BACKUP_SIZE_CHECK_MIN_HISTORY=1  # минимум прошлых бэкапов для сравнения
# BACKUP_SIZE_CHECK_MIN_AGE_HOURS=2 # не проверять размер файлов младше N часов
# BACKUP_CRIT_HOURS=72             # в 🚨 Проблемы копия старше N часов
                                   # считается критичной, а не предупреждением
# BACKUP_WEEKLY_GRACE_HOURS=24     # у недельной копии: насколько раньше срока
                                   # файл ещё считается копией этой недели

# ─── Диски ───────────────────────────────────────────────────
# DISK_FORECAST_ALERT_DAYS=14      # алерт «место скоро кончится» за N дней
# DISK_TEMP_WARN_C=50              # перегрев диска: предупреждение (Linux)
# DISK_TEMP_CRIT_C=60              # перегрев диска: критично (Linux)

# ─── Расписания и тишина ─────────────────────────────────────
# QUIET_HOURS=23:00-07:00          # тихие часы (Алматы); пусто — выключено
# SELF_REPORT_HOUR=9               # час ежедневного самоотчёта монитора
# VERIFY_HOUR=                     # час ежесуточного RESTORE VERIFYONLY;
                                   # пусто — без ограничения по времени
# ALERT_ACK_HOURS=24               # на сколько часов кнопка «Принято»
                                   # глушит конкретный алерт
# ALERT_REPEAT_HOURS=3             # как часто напоминать о проблеме, которая
                                   # никуда не делась; 0 — не напоминать
