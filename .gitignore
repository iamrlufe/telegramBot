# Секреты и рабочий конфиг.
# .env содержит TELEGRAM_TOKEN и пароль PostgreSQL, servers.json — реальные
# хосты и учётки серверов. В репозиторий идёт только config/example.servers.json.
.env
.env.*
!.env.example

# Любой конфиг в config/ считается боевым, в репозиторий идёт только пример.
# Правило намеренно шире, чем servers.json: на серверах рядом лежат копии
# вида servers.json.bak и servers.json.<имя_сервера> — они содержат те же
# реальные хосты и учётки, но под точечное правило не подпадали.
config/*.json
config/servers.json*
!config/example.servers.json
config/ssh_key
config/ssh_key.pub
*.pem
*.key
id_rsa*

# Боевые скрипты копирования, снятые с серверов как есть. Лежат рядом с
# обезличенными образцами, чтобы было с чем сверяться, но в публичный
# репозиторий не идут: внутри настоящий хост приёмника, учётная запись,
# порт и отпечаток ssh-ключа. В git — только scripts/example.*.
scripts/*/

# Мусор ОС и облачных дисков (Google Drive кладёт desktop.ini в каждую папку)
.DS_Store
desktop.ini
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Данные рантайма: том monitor_data (состояния алертов, heartbeat, дефер),
# графики matplotlib и дампы — генерируются на сервере, версионировать нечего
data/
*.log
*.sqlite
*.sqlite3
*.png
*.bak

# Артефакты graphify: ~24 МБ сгенерированного графа, кэша и суточных бэкапов.
# Восстанавливается локально командой `graphify update .`
graphify-out/

# Локальные настройки инструментов
.claude/settings.local.json
.idea/
.vscode/
